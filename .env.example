# =====================================================================
# Project Dementia India: Environment Configuration Example
# =====================================================================
# Copy this file to .env.local for local frontend development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or real API credentials to Git.
# =====================================================================

# Web3Forms access key for Reach Out / Contact form submissions
# Obtain free or pro key from: https://web3forms.com
VITE_WEB3FORMS_KEY=your_web3forms_key_here

# Brevo (formerly Sendinblue) API key for caregiver newsletter signups
# Obtain from: https://app.brevo.com -> Settings -> API Keys
# In production / CI, set as GitLab CI/CD or Vercel environment variable
VITE_BREVO_API_KEY=your_brevo_api_key_here

# Cloudflare Turnstile: Anti-bot and spam protection for forms
# Obtain from: Cloudflare Dashboard -> Turnstile -> Add Widget
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
VITE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
